# --- ADDITIONAL RULES BASED ON USER REQUEST ---
# Ignore everything in the root folder by default
/*

# Except the main executable directory and the README
!/README.md
!/cogitate rater/
!/.gitignore

# Ignore useless files in the main folder
cogitate rater/backend/tests/
cogitate rater/backend/test_com.py
cogitate rater/backend/fix2.py
cogitate rater/backend/fix3.py
cogitate rater/web-next/src/test/
